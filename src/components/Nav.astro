---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const path = Astro.url.pathname;
const here = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const home = lang === 'fr' ? '/' : '/en/';
---

<nav class="nav">
  <div class="container nav-inner">
    <a class="brand" href={home}>
      <span class="brand-dot"></span>
      <span>Gary<span class="grad-text">.dev</span></span>
    </a>
    <ul class="nav-links">
      <li><a href={`${home}#projets`} class={path.includes('/blog') ? '' : ''}>{t.nav.projects}</a></li>
      <li><a href={`${home}#parcours`}>{t.nav.experience}</a></li>
      <li><a href={`${lang === 'fr' ? '/blog' : '/en/blog'}`} class={here(lang === 'fr' ? '/blog' : '/en/blog') ? 'active' : ''}>{t.nav.blog}</a></li>
      <li><a href={`${lang === 'fr' ? '/cv' : '/en/cv'}`} class={here(lang === 'fr' ? '/cv' : '/en/cv') ? 'active' : ''}>{t.nav.cv}</a></li>
      <li><a href={`${home}#contact`}>{t.nav.contact}</a></li>
      <li>
        <div class="lang-switch">
          <a href={lang === 'fr' ? path : path.replace(/^\/en/, '') || '/'} class={lang === 'fr' ? 'active' : ''}>FR</a>
          <a href={lang === 'fr' ? `/en${path === '/' ? '' : path}` : path} class={lang === 'en' ? 'active' : ''}>EN</a>
        </div>
      </li>
    </ul>
    <button class="nav-burger" aria-label="Menu">☰</button>
  </div>
</nav>
