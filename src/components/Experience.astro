---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const items = [
  { period: t.experience.e1_period, role: t.experience.e1_role, desc: t.experience.e1_desc, tags: ['Nuxt 3', 'Laravel', 'SEO', 'SaaS'] },
  { period: t.experience.e2_period, role: t.experience.e2_role, desc: t.experience.e2_desc, tags: ['Vue', 'Laravel', 'MySQL'] },
  { period: t.experience.e3_period, role: t.experience.e3_role, desc: t.experience.e3_desc, tags: ['JavaScript', 'PHP', 'Git'] },
];
---

<section id="parcours">
  <div class="container">
    <div class="kicker" data-reveal>{t.experience.kicker}</div>
    <h2 class="section-title" data-reveal>{t.experience.title}</h2>
    <div class="timeline" style="margin-top:44px;">
      {
        items.map((it, i) => (
          <div class="tl-item" data-reveal data-delay={String(i)}>
            <div class="tl-period">{it.period}</div>
            <h3>{it.role}</h3>
            <div class="tl-role"></div>
            <p>{it.desc}</p>
            <div class="tl-tags">{it.tags.map((tag) => <span class="chip">{tag}</span>)}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>
