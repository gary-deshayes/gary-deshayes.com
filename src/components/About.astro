---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="apropos">
  <div class="container">
    <div class="about-grid">
      <div class="about-text">
        <div class="kicker" data-reveal>{t.about.kicker}</div>
        <h2 class="section-title" data-reveal>{t.about.title}</h2>
        <p data-reveal set:html={t.about.p1}></p>
        <p data-reveal set:html={t.about.p2}></p>
        <p data-reveal>{t.about.p3}</p>
      </div>
      <div class="about-cards">
        <div class="glass about-card" data-reveal>
          <div class="icon">🚀</div>
          <div><h3>{t.about.card1_t}</h3><p>{t.about.card1_d}</p></div>
        </div>
        <div class="glass about-card" data-reveal data-delay="1">
          <div class="icon">⚡</div>
          <div><h3>{t.about.card2_t}</h3><p>{t.about.card2_d}</p></div>
        </div>
        <div class="glass about-card" data-reveal data-delay="2">
          <div class="icon">💰</div>
          <div><h3>{t.about.card3_t}</h3><p>{t.about.card3_d}</p></div>
        </div>
        <div class="glass about-card" data-reveal data-delay="3">
          <div class="icon">🤖</div>
          <div><h3>{t.about.card4_t}</h3><p>{t.about.card4_d}</p></div>
        </div>
      </div>
    </div>
  </div>
</section>
