---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { getPosts, slugOf } from '../../../lib/posts';
import { useTranslations } from '../../../i18n/ui';

const lang = 'en';
const t = useTranslations(lang);
const posts = await getPosts(lang);
---

<Layout lang={lang} title={t.blog.title} description={t.blog.sub}>
  <Nav lang={lang} />
  <main class="article">
    <a class="back" href="/en/">← {t.nav.projects}</a>
    <header>
      <div class="kicker">{t.blog.kicker}</div>
      <h1>{t.blog.title}</h1>
      <p class="section-sub" style="margin-bottom:0;">{t.blog.sub}</p>
    </header>
    <div class="blog-grid" style="margin-top:48px;">
      {
        posts.map((post, i) => (
          <article class="glass post-card" data-reveal data-delay={String(i % 3)}>
            <span class="date mono">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            <h3><a href={`/en/blog/${slugOf(post)}`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <div class="skill-tags">{post.data.tags.map((tag) => <span class="chip">{tag}</span>)}</div>
            <a class="read-more" href={`/en/blog/${slugOf(post)}`}>{t.blog.read} <span class="arrow">→</span></a>
          </article>
        ))
      }
    </div>
  </main>
  <Footer lang={lang} />
</Layout>
